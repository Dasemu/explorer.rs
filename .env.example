# Environment variables recognized by explorer.rs. All are optional.

# Override the base directory used for config, logs and state.
# Default: %APPDATA%\explorer-rs (config) and %LOCALAPPDATA%\explorer-rs (logs).
# EXPLORER_RS_HOME=C:\explorer-rs-data

# Log filter (tracing syntax), e.g. debug, info, or explorer_rs=trace.
# EXPLORER_RS_LOG=debug

# EXPLORER_RS_MODE (dev|shell) is INTERNAL. The supervisor sets it on the
# components it starts. Do not set it yourself.
